# Ordinary development is pinned to the loopback-only shared localnet.
NEXT_PUBLIC_TEZOS_DAPP_NAME="Dos Esposas Local Lab"
NEXT_PUBLIC_TEZOS_NETWORK="localnet"
NEXT_PUBLIC_TEZOS_RPC_URL="http://127.0.0.1:8732"
NEXT_PUBLIC_TEZOS_CHAIN_ID="NetXtJqPyJGB6Pc"
NEXT_PUBLIC_TEZOS_INDEXER_URL=""

# Optional transaction contracts. Indexer-dependent features remain locked on
# localnet; never combine a local RPC with a public TzKT endpoint.
NEXT_PUBLIC_MARKETPLACE_CONTRACT=""
NEXT_PUBLIC_KITCHEN_CONTRACT=""
NEXT_PUBLIC_MIGRATION_CONTRACT=""

# Shadownet mode uses .env.shadownet and the public addresses generated by
# `SHADOWNET_PRIVATE_KEY="edsk..." npm run shadownet:deploy`. The key is read only
# from that command's process environment and must never be written here.
NEXT_PUBLIC_TESTNET_ASSET_CONTRACT=""
# Exact TzKT codeHash for the reviewed deployment. Shadownet mutations fail
# closed unless both the address and this fingerprint match live chain data.
NEXT_PUBLIC_TESTNET_CONTRACT_CODE_HASH=""
NEXT_PUBLIC_TESTNET_POLICY_HASH=""
# Deployment-specific v2 digest generated only after TzKT proves the exact
# origination identity and complete initial authority/supply/metadata snapshot.
NEXT_PUBLIC_TESTNET_DEPLOYMENT_MANIFEST_HASH=""
NEXT_PUBLIC_TESTNET_LEGACY_CONTRACT=""
NEXT_PUBLIC_TESTNET_SYSTEM_WALLET=""
