{
  "name": "dos-esposas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-network.mjs localnet dev",
    "dev:shadownet": "node scripts/run-network.mjs shadownet dev",
    "build": "node scripts/run-network.mjs localnet build",
    "build:shadownet": "node scripts/run-network.mjs shadownet build",
    "start": "node scripts/run-network.mjs localnet start",
    "start:shadownet": "node scripts/run-network.mjs shadownet start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --env-file=.env.localnet --test tests/*.test.ts",
    "verify:ui": "node scripts/visual-check.mjs",
    "mainnet:sync": "node scripts/sync-mainnet-assets.mjs",
    "replacement:sync": "node scripts/sync-replacement-assets.mjs",
    "testnet:compile": "node scripts/compile-testnet.mjs",
    "shadownet:deploy": "node scripts/deploy-testnet.mjs",
    "shadownet:metadata": "node --env-file-if-exists=.env.shadownet.local scripts/manage-testnet-metadata.mjs"
  },
  "dependencies": {
    "@taquito/beacon-wallet": "25.0.0",
    "@taquito/signer": "^25.0.0",
    "@taquito/taquito": "^25.0.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.0"
  }
}
